{
  "name": "desktop",
  "version": "0.0.0",
  "private": true,
  "description": "Creative Canvas for Pika API Club — desktop app (Electron)",
  "author": "yzrkbys",
  "main": "main.cjs",
  "scripts": {
    "build:server": "node build-server.mjs",
    "build:web": "npm -w web run build",
    "build:all": "npm run build:web && npm run build:server",
    "start": "npm run build:all && electron .",
    "dist": "npm run build:all && electron-builder",
    "dist:dir": "npm run build:all && electron-builder --dir",
    "dist:win": "npm run build:all && electron-builder --win --x64",
    "dist:win:dir": "npm run build:all && electron-builder --win --x64 --dir",
    "smoke": "node smoke.mjs"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.2"
  },
  "build": {
    "appId": "com.creativecanvas.pikaapiclub",
    "productName": "Creative Canvas for Pika API Club",
    "electronVersion": "33.4.11",
    "npmRebuild": false,
    "directories": {
      "output": "release",
      "buildResources": "buildResources"
    },
    "files": [
      "main.cjs"
    ],
    "extraResources": [
      {
        "from": "build/server.cjs",
        "to": "server.cjs"
      },
      {
        "from": "build/web",
        "to": "web"
      }
    ],
    "mac": {
      "target": [
        "dmg",
        "dir"
      ],
      "category": "public.app-category.graphics-design",
      "icon": "buildResources/icon.icns"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "buildResources/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "language": "1041",
      "artifactName": "CreativeCanvasForPika-Setup-${version}.${ext}"
    }
  }
}
