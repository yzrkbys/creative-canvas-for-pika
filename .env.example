# Pika Canvas Server
PORT=8797

# Pika API — one key for every model in the catalog (image / video / audio / LLM).
# Issue one at https://dev.pika.art (dashboard). Billing is in USD, and only
# successful generations are charged.
PIKA_API_KEY=

# Optional override of the Pika API base host.
# PIKA_API_BASE=https://api.dev.pika.art

# Set to 1 to use the mock provider (no API calls, no cost) — generates
# placeholder images/videos so the whole pipeline can be exercised offline.
MOCK_PROVIDER=0

# MCP server points at the Pika Canvas Server
PIKA_CANVAS_SERVER_URL=http://127.0.0.1:8797
